<MPD type="dynamic" availabilityStartTime="2026-01-01T00:00:00Z" timeShiftBufferDepth="PT10S">
  <BaseURL availabilityTimeOffset="1">https://cdn.example/</BaseURL>
  <Period start="PT0S">
    <AdaptationSet>
      <Representation id="v">
        <BaseURL availabilityTimeOffset="1">video/</BaseURL>
        <SegmentTemplate duration="4" availabilityTimeOffset="1"
                         availabilityTimeComplete="false" media="$Number$"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
